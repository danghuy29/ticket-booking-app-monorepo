{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    // NestJS dependency injection relies on legacy decorators + reflect-metadata.
    // Bun honours both flags at runtime.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    // Import alias: `@/x` → `src/x`. Bun resolves `paths` at runtime and in `bun test`.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "drizzle.config.ts"]
}
