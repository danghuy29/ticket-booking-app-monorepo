# ─── Dependencies ────────────────────────────────────────────
# No trailing slash: also matches node_modules that are symlinks (Bun isolated installs).
node_modules
**/node_modules
.bun/

# ─── Build output ────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
vite.config.*.timestamp-*

# ─── Environment variables ───────────────────────────────────
# Keep only the templates in git; real values stay local.
.env
.env.*
*.local
!.env.example

# ─── Testing ─────────────────────────────────────────────────
coverage/
*.lcov
junit.xml

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Caches & temp ───────────────────────────────────────────
.cache/
.temp/
.tmp/
*.tmp

# ─── Database ────────────────────────────────────────────────
# Postgres data lives in a Docker volume; ignore local dumps.
*.sql.gz
*.dump
pgdata/

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editors / IDE ───────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── Claude Code (personal, machine-specific settings) ───────
.claude/settings.local.json
CLAUDE.local.md
